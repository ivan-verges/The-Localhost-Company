# ==============================================================================
# The Localhost Company — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust models according to your hardware.
# ==============================================================================

# Ollama Endpoint
OLLAMA_BASE_URL=http://host.containers.internal:11434/v1
OLLAMA_API_BASE=http://host.containers.internal:11434

# 1. CEO Agent Model (paperclip-hq)
CEO_MODEL=hermes3:8b

# 2. Business Analyst Agent Model (analyst-openclaw)
# Recommendations:
# - Standard: gemma4:e4b
# - 8GB RAM: gemma4:e2b or qwen2.5-coder:3b
# - Apple Silicon (M1-M6): gemma4:e4b-mlx or gemma4:e2b-mlx
ANALYST_MODEL=gemma4:e4b

# 3. Developer Agent Model (dev-hermes)
DEV_MODEL=hermes3:8b

# 4. QA Engineer Agent Model (qa-hermes)
QA_MODEL=hermes3:8b
